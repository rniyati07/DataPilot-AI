# --- LLM (not required to be functional for Batch 1 / Phases 0-3) ---
LLM_PROVIDER=openai            # openai | gemini | anthropic
LLM_MODEL=
LLM_API_KEY=

# --- Database (default/sample dataset) ---
DATABASE_URL=sqlite:///./data/ecommerce.db

# --- Database uploads ---
DATABASE_UPLOAD_DIR=./data/uploads
DATABASE_UPLOAD_MAX_MB=50

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
